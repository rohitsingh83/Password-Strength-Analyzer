# ---------------------------------------------------------------------------
# .gitignore -- Password Strength Analyzer & Security Suggestion Tool
# ---------------------------------------------------------------------------

# --- Secrets and environment files (NEVER commit these) -------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
.github/

# --- Local analytics database (aggregate metadata only, but still local) ---
data/analytics.db
data/analytics.db-journal
data/*.db
data/*.sqlite
data/*.sqlite3

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
.venv/
env/
ENV/
.python-version

# --- Testing / coverage -----------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# --- Node (only used for the JavaScript parity test) ------------------------
node_modules/
npm-debug.log*
yarn-error.log
.pnpm-debug.log

# --- Editors and operating systems -----------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Logs and temporary files ---------------------------------------------
*.log
logs/
*.tmp
tmp/
.cache/

# --- Local scratch notes (keep private working files out of the repo) ------
scratch/
private/
notes.local.md
