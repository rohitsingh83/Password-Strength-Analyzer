# ---------------------------------------------------------------------------
# Example environment configuration. Copy to `.env` and edit locally.
# NEVER commit a real `.env` file -- it is listed in .gitignore.
#
# Every variable here is OPTIONAL. With none of them set, the application runs
# with safe defaults: analytics metadata enabled, no passwords stored anywhere.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Largest accepted request body in bytes (protects against oversized payloads).
MAX_CONTENT_LENGTH=65536

# --- Privacy / analytics --------------------------------------------------
# 1 = store NON-SECRET aggregate metadata (score, classification, length).
# 0 = store nothing at all. The analyzer behaves identically either way.
ANALYTICS_ENABLED=1

# Legacy alias, still honoured: ANON_HISTORY_ENABLED=1

# Set to 0 to keep the analyzer working but skip writing to SQLite.
STORE_ANALYTICS=1

# Path to the SQLite file holding aggregate metadata only.
# The schema has no password column and no password-hash column.
DATABASE_PATH=data/analytics.db

# --- Production notes -----------------------------------------------------
# * Terminate TLS in front of this service (HTTPS is required in production).
# * Put a shared rate limiter (for example Redis) in front if you run several
#   worker processes, because the built-in limiter is per-process.
# * Keep the analysis endpoint on the same origin as the UI so the browser's
#   same-origin policy applies.
